[Unit]
Description=Validate ArchieOS model and harness router configuration
After=archie-vault.service

[Service]
Type=oneshot
User=archie
Group=archie
ExecStart=/usr/bin/archie-workstation-check router
RemainAfterExit=true
NoNewPrivileges=true
ProtectSystem=strict
ReadOnlyPaths=/vault

[Install]
WantedBy=archie-workstation.target

