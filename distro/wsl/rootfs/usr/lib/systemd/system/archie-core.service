[Unit]
Description=ArchieOS trusted control plane
Requires=archie-database.service
After=local-fs.target archie-database.service

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=120
WatchdogSec=60
User=archie
Group=archie
ExecStart=/usr/bin/archied
Restart=on-failure
RestartPreventExitStatus=78
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RuntimeDirectory=archie
RuntimeDirectoryMode=0750
StateDirectory=archie
StateDirectoryMode=0750
LogsDirectory=archie
LogsDirectoryMode=0750
ConfigurationDirectory=archie
UMask=0007
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=archie-workstation.target
