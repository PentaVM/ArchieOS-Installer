#!/usr/bin/env bash
# First-time setup of the operator image: IRIS's Python environment, its weights, and the
# key of the reasoning model. Safe to run again; each part is skipped once it is done.
#
#   archie-setup            everything that is missing
#   archie-setup key        replace the Nebius key
#   archie-setup status     what is in place
set -euo pipefail
VENV=/opt/archie/iris-venv
WEIGHTS=/var/lib/archie/models/iris/iris-beta21-step132000.pt
WEIGHTS_SHA=c6cadb02f5a5bffc4ea3c3348d32b475ef7531f643675c06c65451037e4f3b97
KEY=$HOME/.config/archie/nebius.key

python_ready() { [ -x "$VENV/bin/python" ] && "$VENV/bin/python" -c 'import torch, transformers, timm' 2>/dev/null; }

ask_key() {
  mkdir -p "$(dirname "$KEY")" && chmod 700 "$(dirname "$KEY")"
  printf 'Nebius Token Factory key (not shown): ' >&2
  IFS= read -rs value
  echo >&2
  [ -n "$value" ] || { echo 'archie-setup: no key given' >&2; return 1; }
  ( umask 077; printf '%s\n' "$value" > "$KEY" )
  unset value
}

status() {
  if python_ready; then
    echo "python:  ready ($("$VENV/bin/python" -c 'import torch; print("torch", torch.__version__, "with CUDA" if torch.cuda.is_available() else "CPU only")'))"
  else
    echo 'python:  missing'
  fi
  if [ -f "$WEIGHTS" ]; then echo "weights: $WEIGHTS"; else echo "weights: missing ($WEIGHTS)"; fi
  if [ -s "$KEY" ]; then echo 'key:     set'; else echo 'key:     missing'; fi
  if command -v nvidia-smi >/dev/null; then
    nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null | sed 's/^/gpu:     /'
  else
    echo 'gpu:     nvidia-smi not found (install the NVIDIA driver on Windows; WSL shares it)'
  fi
}

case "${1:-all}" in
  status) status; exit 0 ;;
  key) ask_key; exit 0 ;;
  all) ;;
  *) echo 'usage: archie-setup [status|key]' >&2; exit 64 ;;
esac

if ! python_ready; then
  echo 'archie-setup: installing PyTorch and what IRIS needs (about 3 GB, once)' >&2
  python -m venv "$VENV"
  "$VENV/bin/pip" install --quiet --upgrade pip
  # ARCHIE_TORCH_INDEX names another wheel index, e.g. https://download.pytorch.org/whl/cpu
  "$VENV/bin/pip" install ${ARCHIE_TORCH_INDEX:+--index-url "$ARCHIE_TORCH_INDEX"} torch torchvision
  grep -vE '^(#|torch|$)' /opt/archie/iris/requirements-iris.txt | xargs "$VENV/bin/pip" install
fi

if [ ! -f "$WEIGHTS" ]; then
  echo "archie-setup: IRIS's weights are not here. Copy iris-beta21-step132000.pt to $WEIGHTS" >&2
  echo '  (the installer does this; from Windows the folder is \\wsl.localhost\ArchieOS-Operator\var\lib\archie\models\iris)' >&2
  exit 1
fi
if [ ! -f "$WEIGHTS.verified" ]; then
  echo 'archie-setup: checking the weights' >&2
  [ "$(sha256sum "$WEIGHTS" | cut -d' ' -f1)" = "$WEIGHTS_SHA" ] || { echo 'archie-setup: the weights file is not IRIS Beta 2.1 step 132000' >&2; exit 1; }
  : > "$WEIGHTS.verified"
fi
[ -s "$KEY" ] || [ -n "${NEBIUS_TOKEN_FACTORY_KEY:-}" ] || ask_key
status
echo 'Ready. Try: archie-operate "do a flip reset" --app car-soccer'
