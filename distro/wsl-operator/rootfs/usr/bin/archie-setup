#!/usr/bin/env bash
# First-time setup of the operator image: the voice (speech recognition and two Piper
# voices) and the key of the reasoning model. IRIS needs nothing here: the runtime, its
# weights and its text tower are in the image.
# Safe to run again; each part is skipped once it is done.
#
#   archie-setup            everything that is missing
#   archie-setup key        replace the Nebius key
#   archie-setup status     what is in place
set -euo pipefail
VENV=/opt/archie/voice-venv
WEIGHTS=/var/lib/archie/models/iris/iris-beta21-step132000.pt
WEIGHTS_SHA=c6cadb02f5a5bffc4ea3c3348d32b475ef7531f643675c06c65451037e4f3b97
TEXT_TOWER=/var/lib/archie/models/iris/siglip2-text/model.safetensors
KEY=$HOME/.config/archie/nebius.key
# Nemotron 3.5 ASR, the revision and digest scripts/models/install-nemotron-speech.sh pins.
ASR=/var/lib/archie/models/asr/nemotron-3.5-asr-streaming-0.6b.q8_0.gguf
ASR_SHA=a5c435f294eea8f88ce68dd27b8c3bfea7f777cb2fbba04fcd30eaa555f429ae
ASR_URL=https://huggingface.co/nvidia/nemotron-3.5-asr-streaming-0.6b/resolve/1c8deaecc64b91f034d73e08dd8b64625eb3395d/nemotron-3.5-asr-streaming-0.6b.q8_0.gguf
VOICES=/var/lib/archie/models/piper

piper_ready() { [ -x "$VENV/bin/python" ] && "$VENV/bin/python" -c 'import onnxruntime, piper' 2>/dev/null; }

ask_key() {
  mkdir -p "$(dirname "$KEY")" && chmod 700 "$(dirname "$KEY")"
  printf 'Nebius Token Factory key (not shown): ' >&2
  IFS= read -rs value
  echo >&2
  [ -n "$value" ] || { echo 'archie-setup: no key given' >&2; return 1; }
  ( umask 077; printf '%s\n' "$value" > "$KEY" )
  unset value
}

status() {
  if [ -f "$WEIGHTS" ] && [ -f "$TEXT_TOWER" ]; then
    echo "iris:    $(basename "$WEIGHTS") and its text tower, in the image"
  else
    echo 'iris:    the weights or the text tower are missing from the image'
  fi
  if [ -f "$ASR" ] && piper_ready && [ -f "$VOICES/es_MX-ald-medium.onnx" ]; then
    echo 'voice:   ready (hears with Nemotron 3.5 ASR, speaks with Piper)'
  else
    echo 'voice:   missing'
  fi
  if [ -s "$KEY" ]; then echo 'key:     set'; else echo 'key:     missing'; fi
  if [ -L "$HOME/ArchieOS" ] && [ -d "$HOME/ArchieOS" ]; then
    echo "folder:  ~/ArchieOS is $(readlink "$HOME/ArchieOS")"
  else
    echo 'folder:  no shared folder (the installer makes one on the Windows desktop)'
  fi
  if command -v nvidia-smi >/dev/null; then
    nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null | sed 's/^/gpu:     /'
  else
    echo 'gpu:     nvidia-smi not found (install the NVIDIA driver on Windows; WSL shares it)'
  fi
}

case "${1:-all}" in
  status) status; exit 0 ;;
  key) ask_key; exit 0 ;;
  all) ;;
  *) echo 'usage: archie-setup [status|key]' >&2; exit 64 ;;
esac

[ -f "$WEIGHTS" ] && [ -f "$TEXT_TOWER" ] || {
  echo 'archie-setup: IRIS is not complete in this image; reinstall it from the release' >&2
  exit 1
}
if [ ! -f "$WEIGHTS.verified" ]; then
  echo 'archie-setup: checking the weights' >&2
  [ "$(sha256sum "$WEIGHTS" | cut -d' ' -f1)" = "$WEIGHTS_SHA" ] || { echo 'archie-setup: the weights file is not IRIS Beta 2.1 step 132000' >&2; exit 1; }
  : > "$WEIGHTS.verified" 2>/dev/null || true
fi

# The voice. It runs on this machine: what is said is recognised and spoken here, and
# only the words of a question go to the reasoning model.
if ! piper_ready; then
  echo 'archie-setup: installing Piper, the voice Archie speaks with' >&2
  [ -x "$VENV/bin/python" ] || python -m venv "$VENV"
  "$VENV/bin/pip" install --quiet 'piper-tts==1.8.0' 'onnxruntime==1.30.0'
fi
PIPER_VOICES=$VOICES /usr/lib/archie/install-piper-voices >&2
if ! { [ -f "$ASR" ] && printf '%s  %s\n' "$ASR_SHA" "$ASR" | sha256sum --check --status; }; then
  echo 'archie-setup: downloading the speech recogniser (about 700 MB, once)' >&2
  mkdir -p "$(dirname "$ASR")"
  curl --fail --location --proto '=https' --tlsv1.2 "$ASR_URL" -o "$ASR.part"
  printf '%s  %s\n' "$ASR_SHA" "$ASR.part" | sha256sum --check --status || {
    rm -f "$ASR.part"
    echo 'archie-setup: the speech recogniser did not arrive whole; run archie-setup again' >&2
    exit 1
  }
  mv "$ASR.part" "$ASR"
fi

# ARCHIE_SETUP_NO_KEY: the Windows installer passes the key itself (archie-setup key), or
# none, when a local model answers.
[ -s "$KEY" ] || [ -n "${NEBIUS_TOKEN_FACTORY_KEY:-}" ] || [ -n "${ARCHIE_SETUP_NO_KEY:-}" ] || ask_key
status
cat <<'EOF'
Ready.
  archie-talk                                             talk with Archie; say "Archie" first
  archie-operate "do a flip reset" --app car-soccer       have IRIS work a screen
  archie-video                                            the video bridge on ~/ArchieOS
  archie-design                                           the desktop design, as a preview
EOF
