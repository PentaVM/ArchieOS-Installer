#!/usr/bin/env bash
# Talk with Archie. By default it answers when it is called by name ("Archie, ..."); the
# installer's "everything it hears" (or --always) lets the floor weigh whatever it hears, and
# it answers when it has been given enough and there is a longer pause. It answers aloud in the language it
# was spoken to, Spanish or English, each with its own male voice, and opens the
# applications the Stage's policy names (Kdenlive, the browser) when asked.
#
#   archie-talk                 the microphone goes quiet while Archie speaks
#   archie-talk --headphones    keeps listening while it speaks, so it can be interrupted
#   archie-talk --local         the reasoning model on this machine answers: the one
#                               archie-local use 27b|9b chose
#   archie-talk --spanish       listens for Spanish only (by default, either language)
#   archie-talk --cloud         Nemotron on Nebius answers
#   archie-talk --nemotron      the all-NVIDIA test: Nemotron 3 Nano Omni (served from Windows by
#                               archie-omni) hears, sees and answers; Magpie speaks
#   archie-talk --named         only what starts with "Archie" is weighed (the default): for
#                               a room with other people talking
#   archie-talk --always        whatever is heard is weighed, its name or not
#
# What you say is recognised on this machine. Which model answers: the one on this
# machine once its GPU runtime is built (archie-local gpu), and nothing then leaves;
# otherwise Nemotron on Nebius, which is sent the words of what you ask.
# Each session is also kept in ~/.archie/talk/sessions/<date>.log, readable only by you.
set -euo pipefail
KEY=$HOME/.config/archie/nebius.key
grade=public
where=auto
# How it listens and in which language: what the installer wrote (profile.json, the same file
# archie-offline reads), else only when called by name and either language. Options win.
PROFILE=$HOME/.config/archie/profile.json
export ALWAYS=0
if [ -f "$PROFILE" ]; then
  grep -Eq '"listen"[[:space:]]*:[[:space:]]*"always"' "$PROFILE" && export ALWAYS=1
  asr=$(grep -Eo '"asr_language"[[:space:]]*:[[:space:]]*"[a-z]{2}-[A-Z]{2}"' "$PROFILE" | grep -Eo '[a-z]{2}-[A-Z]{2}' || true)
  [ -n "$asr" ] && export LISTEN_LANGUAGE=$asr
fi
for option in "$@"; do
  case "$option" in
    --headphones) export HEADPHONES=1 ;;
    --local) where=local ;;
    --cloud) where=cloud ;;
    --nemotron) where=omni ;;
    --always) export ALWAYS=1 ;;
    --named) export ALWAYS=0 ;;
    --spanish) export LISTEN_LANGUAGE=es-US ;;
    *) sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 64 ;;
  esac
done
# One voice at a time, decided before anything else is touched: two would hear each
# other through the speakers and answer each other. By the voice's own process, not a
# lock file: what it leaves running (the model's server) would hold a lock for ever.
if pgrep -u "$(id -u)" -f '[a]rchie-voice converse' >/dev/null; then
  echo "archie-talk: Archie's voice is already open" >&2
  exit 0
fi
if [ "$where" = omni ]; then
  archie-omni up
  export ARCHIE_VOICE_ENDPOINT=http://127.0.0.1:${OMNI_PORT:-8110}/v1 ARCHIE_VOICE_MODEL=nemotron-omni
  export ARCHIE_VOICE_GUIDE=/usr/share/archie/skills/voice-local/SKILL.md
  # The model hears each utterance too, and NVIDIA's Magpie speaks for it.
  export MODEL_HEARS=1 VOICE_ENGINE=magpie TTS_VOICE=${ARCHIE_MAGPIE_VOICE:-John}
  { read -r TTS_MODEL; read -r CODEC_MODEL; read -r TTS_TOKENIZER; } < <(archie-omni voice)
  export TTS_MODEL CODEC_MODEL TTS_TOKENIZER
  grade=internal
  echo "archie-talk: Nemotron 3 Nano Omni hears and answers on this machine; Magpie ($TTS_VOICE) speaks" >&2
fi
if [ "$where" = auto ]; then
  if archie-local ready; then where=local; else where=cloud; fi
fi
if [ "$where" = local ]; then
  archie-local up
  read -r local_name local_url local_alias < <(archie-local current)
  export ARCHIE_VOICE_ENDPOINT=$local_url ARCHIE_VOICE_MODEL=$local_alias
  # A small model is shown how to speak or to call a tool; IRIS does the seeing.
  export ARCHIE_VOICE_GUIDE=/usr/share/archie/skills/voice-local/SKILL.md
  grade=internal
  echo "archie-talk: Bonsai $local_name on this machine answers (archie-local use 27b|9b to change it; archie-talk --cloud for Nebius)" >&2
fi
if [ -z "${ARCHIE_VOICE_ENDPOINT:-}" ] && [ -z "${NEBIUS_TOKEN_FACTORY_KEY:-}" ]; then
  [ -s "$KEY" ] || { echo 'archie-talk: run archie-setup first' >&2; exit 1; }
  NEBIUS_TOKEN_FACTORY_KEY=$(cat "$KEY")
  export NEBIUS_TOKEN_FACTORY_KEY
fi
# IRIS and the operator's Stage use the same sockets; one of the two at a time.
archie-session down >/dev/null 2>&1 || true
[ -S /mnt/wslg/runtime-dir/wayland-0 ] || { echo 'archie-talk: WSLg is not running, so there is no screen or sound to use' >&2; exit 1; }

# NVIDIA's current GGUF carries its tokenizer, so Archie's name can be boosted; the pinned one
# (scripts/models/install-nemotron-speech.sh) hears the same without it.
ASR_MODEL=/var/lib/archie/models/asr/nemotron-3.5-asr-streaming-0.6b.q8_0.hf.gguf
[ -f "$ASR_MODEL" ] || ASR_MODEL=/var/lib/archie/models/asr/nemotron-3.5-asr-streaming-0.6b.q8_0.gguf
export ASR_MODEL
export PIPER=/usr/lib/archie/piper-json-bridge.py
# Piper runs under the Python that has it: the image's voice venv, or IRIS's on a node set
# up before the voice had its own.
venv=/opt/archie/voice-venv
[ -x "$venv/bin/python" ] || venv=/opt/archie/iris-venv
export PIPER_PYTHON=$venv/bin/python
export PIPER_VOICES=/var/lib/archie/models/piper
# Either language is heard, and each reply is spoken by the voice of its language.
export LISTEN_LANGUAGE=${LISTEN_LANGUAGE:-auto}
export POLICY=/usr/share/archie/stage/apps.toml
export HOST_WAYLAND=/mnt/wslg/runtime-dir/wayland-0
export RUN_DIR=$HOME/.archie/talk
export SESSION_LOG=$RUN_DIR/sessions/$(date +%F_%H-%M-%S).log
echo "archie-talk: this conversation is also kept in $SESSION_LOG" >&2
# That Python first on the PATH; the Stage draws without a GPU, since WSLg shares no
# buffers with a nested compositor.
export PATH=$venv/bin:$PATH
export LIBGL_ALWAYS_SOFTWARE=1
exec /usr/lib/archie/run-archie.sh "$grade"
