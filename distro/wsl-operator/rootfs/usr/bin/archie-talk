#!/usr/bin/env bash
# Talk with Archie. Say "Archie" to be heard. It answers aloud, in Spanish or English,
# and opens the applications the Stage's policy names (Kdenlive, the browser) when asked.
#
#   archie-talk                 the microphone goes quiet while Archie speaks
#   archie-talk --headphones    keeps listening while it speaks, so it can be interrupted
#
# What you say is recognised on this machine. The words of what you ask go to the
# reasoning model on Nebius, so this is for things you would say in public.
set -euo pipefail
KEY=$HOME/.config/archie/nebius.key
if [ -z "${NEBIUS_TOKEN_FACTORY_KEY:-}" ]; then
  [ -s "$KEY" ] || { echo 'archie-talk: run archie-setup first' >&2; exit 1; }
  NEBIUS_TOKEN_FACTORY_KEY=$(cat "$KEY")
fi
export NEBIUS_TOKEN_FACTORY_KEY
case "${1:-}" in
  --headphones) export HEADPHONES=1 ;;
  '') ;;
  *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 64 ;;
esac
# IRIS and the operator's Stage use the same sockets; one of the two at a time.
archie-session down >/dev/null 2>&1 || true
[ -S /mnt/wslg/runtime-dir/wayland-0 ] || { echo 'archie-talk: WSLg is not running, so there is no screen or sound to use' >&2; exit 1; }

export ASR_MODEL=/var/lib/archie/models/asr/nemotron-3.5-asr-streaming-0.6b.q8_0.gguf
export PIPER=/usr/lib/archie/piper-json-bridge.py
export PIPER_PYTHON=/opt/archie/iris-venv/bin/python
export PIPER_VOICES=/var/lib/archie/models/piper
export POLICY=/usr/share/archie/stage/apps.toml
export HOST_WAYLAND=/mnt/wslg/runtime-dir/wayland-0
export RUN_DIR=$HOME/.archie/talk
# Piper's adapter runs under the Python that has Piper; the Stage draws without a GPU,
# since WSLg shares no buffers with a nested compositor.
export PATH=/opt/archie/iris-venv/bin:$PATH
export LIBGL_ALWAYS_SOFTWARE=1
exec /usr/lib/archie/run-archie.sh public
