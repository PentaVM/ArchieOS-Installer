#!/usr/bin/env bash
# Native desktop through WSLg. --preview explicitly selects synthetic design boards.
set -euo pipefail
[ -S /mnt/wslg/runtime-dir/wayland-0 ] || { echo 'archie-design: WSLg is not running, so there is nowhere to show it' >&2; exit 1; }
export XDG_RUNTIME_DIR=/mnt/wslg/runtime-dir WAYLAND_DISPLAY=wayland-0 QT_QPA_PLATFORM=wayland
if [[ ${1:-} != --preview ]]; then
  # Core and displayd keep their own process/authority lifecycle. Opening a design
  # window cannot start privileged services or replace an existing observer.
  exec /usr/lib/archie/start-native.sh "$@"
fi
shift
cd /usr/share/archie/shell-prototype
XDG_RUNTIME_DIR=/mnt/wslg/runtime-dir WAYLAND_DISPLAY=wayland-0 QT_QPA_PLATFORM=wayland QT_QUICK_BACKEND=software \
  exec /usr/lib/qt6/bin/qml Main.qml "$@"
