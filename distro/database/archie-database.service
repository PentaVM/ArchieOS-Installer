[Unit]
Description=Provision and verify the ArchieOS application database
Requires=archie-postgres.service
After=archie-postgres.service systemd-tmpfiles-setup.service
Before=archied.service

[Service]
Type=oneshot
ExecStart=/usr/lib/archie/provision-node
RemainAfterExit=yes
TimeoutStartSec=120
UMask=0077
ProtectHome=yes
PrivateTmp=yes
