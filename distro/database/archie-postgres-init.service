[Unit]
Description=Initialize the dedicated ArchieOS PostgreSQL cluster
Before=archie-postgres.service

[Service]
Type=oneshot
User=postgres
Group=postgres
StateDirectory=archie-postgres
StateDirectoryMode=0700
ExecStart=/usr/lib/archie/initialize-cluster
RemainAfterExit=yes
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
