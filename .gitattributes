# ArchieOS is developed on Windows and boots on Linux. A stray CR in a systemd unit,
# tmpfiles.d entry or shell script becomes part of the last field on that line and can
# make the ISO fail at boot in ways that are painful to trace.
#
# `core.autocrlf` is per-developer configuration and cannot be relied on. These rules
# live in the repository, so every checkout gets LF for anything the OS itself parses.

* text=auto eol=lf

# Everything that ends up inside the image, or builds it.
distro/**            text eol=lf
*.sh                 text eol=lf
*.service            text eol=lf
*.conf               text eol=lf
*.preset             text eol=lf
*.network            text eol=lf
*.toml               text eol=lf
*.rs                 text eol=lf

# Binary content git must never touch.
*.iso                binary
*.png                binary
*.jpg                binary
*.glb                binary
*.gltf               binary
# A tile corpus and a model checkpoint are bytes that happen to contain no zero in
# their first few thousand, so git would otherwise take them for text.
*.bin                binary
*.checkpoint         binary
# Signed bytes: a line-ending conversion would invalidate the release signature.
distro/windows/archieos-manifest.json -text
distro/windows/archieos-manifest.json.sig -text
