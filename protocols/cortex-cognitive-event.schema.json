{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archie.os/protocols/cortex-cognitive-event.schema.json",
  "title": "Archie cognitive event v1",
  "description": "Local/distributed-store-independent envelope. Cross-record identity, time, Focus lineage and signal measurement validation are enforced by trusted Rust contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "recorded_at_ms",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9:._/-]+$"
    },
    "recorded_at_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "focus_updated"
            },
            "value": {
              "$ref": "#/$defs/focus"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "training"
            },
            "value": {
              "$ref": "#/$defs/training"
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focus_id",
        "revision",
        "objective_ref",
        "parent_focus_id",
        "suspended",
        "half_life_ms",
        "updated_at_ms",
        "activations"
      ],
      "properties": {
        "focus_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192,
          "pattern": "^[A-Za-z0-9:._/-]+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "objective_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192,
          "pattern": "^[A-Za-z0-9:._/-]+$"
        },
        "parent_focus_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 192,
              "pattern": "^[A-Za-z0-9:._/-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "suspended": {
          "type": "boolean"
        },
        "half_life_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "updated_at_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "activations": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "strength",
              "activated_at_ms",
              "pinned"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 192,
                "pattern": "^[A-Za-z0-9:._/-]+$"
              },
              "strength": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "activated_at_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "pinned": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "subject_id",
        "snapshot_id",
        "focus_id",
        "evidence_ref",
        "signal",
        "observed",
        "recorded_at_ms"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192,
          "pattern": "^[A-Za-z0-9:._/-]+$"
        },
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192,
          "pattern": "^[A-Za-z0-9:._/-]+$"
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192,
          "pattern": "^[A-Za-z0-9:._/-]+$"
        },
        "focus_id": {
          "type": "string",
          "maxLength": 192,
          "pattern": "^[A-Za-z0-9:._/-]*$"
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192,
          "pattern": "^[A-Za-z0-9:._/-]+$"
        },
        "signal": {
          "enum": [
            "context_useful",
            "context_irrelevant",
            "missing_context",
            "task_outcome",
            "process_sample"
          ]
        },
        "observed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quality",
            "relevance",
            "confidence",
            "privacy_exposure",
            "risk",
            "latency_ms",
            "tokens",
            "cpu_ms",
            "memory_bytes",
            "energy_joules",
            "task_success"
          ],
          "properties": {
            "quality": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "relevance": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "confidence": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "privacy_exposure": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "risk": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "latency_ms": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "tokens": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "cpu_ms": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "memory_bytes": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "energy_joules": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "task_success": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "recorded_at_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    }
  }
}
