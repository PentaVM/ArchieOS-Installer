{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archie.os/protocols/wanda-event.schema.json",
  "title": "WandaEventV1",
  "description": "Scoped content envelope, separate from CaptureEvent. HTTP /v1/events accepts a JSON array of 1-32 envelopes, <=256 KiB. A source token fixes device, source and domain; envelopes cannot choose a domain. Runtime ID validation additionally enforces <=192 UTF-8 bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "device_id", "actor", "author", "source", "chat_id", "sender", "source_message_id", "sent_at_ms", "observed_at_ms", "text", "media_omitted", "coverage"],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 192, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "$ref": "#/$defs/id" },
    "device_id": { "$ref": "#/$defs/id" },
    "actor": { "enum": ["confirmed_owner", "presumed_owner", "unknown", "confirmed_other"] },
    "author": { "enum": ["owner", "counterparty", "system"] },
    "source": { "enum": ["android_notification", "whatsapp_visible_dom", "iris_semantic"] },
    "chat_id": { "$ref": "#/$defs/id" },
    "sender": { "$ref": "#/$defs/id" },
    "source_message_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "sent_at_ms": { "type": ["integer", "null"], "minimum": 1, "maximum": 9223372036854775807, "description": "Source message epoch milliseconds only. Null means unknown; observation time is never substituted." },
    "observed_at_ms": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "text": { "type": "string", "maxLength": 2000 },
    "media_omitted": { "type": "boolean" },
    "coverage": { "enum": ["notification_preview", "visible_chat", "semantic_observation"] },
    "monitor_id": { "$ref": "#/$defs/id" },
    "window_id": { "$ref": "#/$defs/id" }
  },
  "allOf": [
    { "if": { "properties": { "source": { "const": "android_notification" } } }, "then": { "properties": { "coverage": { "const": "notification_preview" } } } },
    { "if": { "properties": { "source": { "const": "whatsapp_visible_dom" } } }, "then": { "properties": { "coverage": { "const": "visible_chat" } } } },
    { "if": { "properties": { "source": { "const": "iris_semantic" } } }, "then": { "properties": { "coverage": { "const": "semantic_observation" } } }, "else": { "not": { "anyOf": [{ "required": ["monitor_id"] }, { "required": ["window_id"] }] } } },
    { "if": { "properties": { "media_omitted": { "const": false } } }, "then": { "properties": { "text": { "minLength": 1, "pattern": "\\S" } } } }
  ]
}
