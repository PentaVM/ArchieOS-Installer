# Copy values into your environment or an untracked secret manager. Never commit keys.
NVIDIA_API_KEY=
NEBIUS_TOKEN_FACTORY_KEY=
# Tavily web search (archie-search). Public queries only until retention is verified.
TAVILY_API_KEY=

# Local NVIDIA NIM default. Remote endpoints must use HTTPS.
ARCHIE_NVIDIA_NIM_BASE_URL=http://127.0.0.1:8000/v1
ARCHIE_NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
